<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Auth.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Auth.Models"
             xmlns:shared="using:GestionCommerciale.Shared.Views"
             xmlns:conv="using:GestionCommerciale.Shared.Converters"
             x:Class="GestionCommerciale.Modules.Auth.Views.VendeursView"
             x:DataType="vm:VendeursViewModel">
  <Grid ColumnDefinitions="420,*">
    <Border Padding="12" CornerRadius="8" BorderBrush="#28000000" BorderThickness="1"
            Background="#06000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Button Content="{Binding BtnNew}" MinWidth="140" Padding="8,6" Margin="0,0,0,10"
                Command="{Binding NewVendeurCommand}" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="1" Text="{Binding HelpList}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="{Binding WmSearch}" Margin="0,0,0,8"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                  BorderBrush="#20000000" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,140,70">
              <TextBlock Text="{Binding ColNom}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding ColPhone}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="{Binding ColActif}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Vendeurs}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,8"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:User">
                <Grid ColumnDefinitions="*,140,70">
                  <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Phone}" VerticalAlignment="Center"
                             Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Actif, Converter={x:Static conv:BoolActifLabelConverter.Instance}}"
                             VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Opacity="0.85"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" CornerRadius="8"
            BorderBrush="#28000000" BorderThickness="1" Background="#06000000"
            IsVisible="{Binding ShowFiche}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding LblFiche}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LblDraftHint}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       IsVisible="{Binding IsNewDraft}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,12,*,12,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LblNom}" FontWeight="SemiBold" FontSize="12"/>
              <TextBox Text="{Binding FicheNom}" IsEnabled="{Binding FicheEditable}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{Binding LblPhone}" FontWeight="SemiBold" FontSize="12"/>
              <TextBox Text="{Binding FichePhone}" IsEnabled="{Binding FicheEditable}"/>
            </StackPanel>
            <CheckBox Grid.Column="4" Content="{Binding LblActif}" IsChecked="{Binding FicheActif}"
                      IsEnabled="{Binding FicheEditable}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          </Grid>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" CornerRadius="8"
                BorderBrush="#28000000" BorderThickness="1" Background="#08000000"
                IsVisible="{Binding ShowSolde}">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="{Binding LblSolde}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,12">
              <Border Background="#E0F2FE" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding LblQtyTotal}" FontSize="11" Foreground="#0369A1"/>
                  <TextBlock Text="{Binding QtyTotalLabel}" FontSize="15" FontWeight="Bold" Foreground="#0C4A6E"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="8" Padding="10,8">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding LblValVenteTtc}" FontSize="11" Foreground="#047857"/>
                  <TextBlock Text="{Binding ValVenteTtcLabel}" FontSize="15" FontWeight="Bold" Foreground="#065F46"/>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto,*">
              <TextBlock Text="{Binding EmptyStock}" FontSize="12" Opacity="0.7"
                         IsVisible="{Binding !HasStockLines}" Margin="0,4,0,0"/>

              <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasStockLines}">
                <Border Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                        BorderBrush="#20000000" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="110,*,80,140">
                    <TextBlock Text="{Binding ColRef}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{Binding ColDesignation}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding ColQty}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Foreground="#0369A1"/>
                    <TextBlock Grid.Column="3" Text="{Binding ColValVenteTtc}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="8,0,0,0" Foreground="#047857"/>
                  </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding StockLines}" BorderThickness="0" Background="Transparent">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="10,6"/>
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:VendeurStockLineRow">
                      <Grid ColumnDefinitions="110,*,80,140">
                        <TextBlock Text="{Binding Reference}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Designation}" FontSize="11" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuantiteLabel}" FontSize="11" TextAlignment="Right"
                                   FontWeight="SemiBold" Foreground="#0369A1"/>
                        <TextBlock Grid.Column="3" Text="{Binding ValeurVenteTtcLabel}" FontSize="11" TextAlignment="Right"
                                   Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#065F46"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding FicheEditable}" MinWidth="120"/>
          <Button Content="{Binding BtnDelete}" Command="{Binding DeleteCommand}"
                  IsEnabled="{Binding CanDelete}" Classes="pos-delete" MinWidth="120"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
