<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Auth.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Auth.Models"
             xmlns:shared="using:GestionCommerciale.Shared.Views"
             xmlns:conv="using:GestionCommerciale.Shared.Converters"
             x:Class="GestionCommerciale.Modules.Auth.Views.VendeursView"
             x:DataType="vm:VendeursViewModel">
  <Grid ColumnDefinitions="420,*">
    <Border Padding="12" CornerRadius="8" BorderBrush="#28000000" BorderThickness="1"
            Background="#06000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Button Content="{Binding BtnNew}" MinWidth="140" Padding="8,6" Margin="0,0,0,10"
                Command="{Binding NewVendeurCommand}" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="1" Text="{Binding HelpList}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="{Binding WmSearch}" Margin="0,0,0,8"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                  BorderBrush="#20000000" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,140,70">
              <TextBlock Text="{Binding ColNom}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding ColPhone}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="{Binding ColActif}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Vendeurs}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,8"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:User">
                <Grid ColumnDefinitions="*,140,70">
                  <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Phone}" VerticalAlignment="Center"
                             Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Actif, Converter={x:Static conv:BoolActifLabelConverter.Instance}}"
                             VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Opacity="0.85"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" CornerRadius="8"
            BorderBrush="#28000000" BorderThickness="1" Background="#06000000">
      <StackPanel Spacing="12" MaxWidth="420">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding LblFiche}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LblDraftHint}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                     IsVisible="{Binding IsNewDraft}"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LblNom}" FontWeight="SemiBold" FontSize="12"/>
          <TextBox Text="{Binding FicheNom}" IsEnabled="{Binding FicheEditable}"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding LblPhone}" FontWeight="SemiBold" FontSize="12"/>
          <TextBox Text="{Binding FichePhone}" IsEnabled="{Binding FicheEditable}"/>
        </StackPanel>
        <CheckBox Content="{Binding LblActif}" IsChecked="{Binding FicheActif}"
                  IsEnabled="{Binding FicheEditable}"/>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding FicheEditable}" MinWidth="120"/>
          <Button Content="{Binding BtnDelete}" Command="{Binding DeleteCommand}"
                  IsEnabled="{Binding CanDelete}" Classes="pos-delete" MinWidth="120"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
