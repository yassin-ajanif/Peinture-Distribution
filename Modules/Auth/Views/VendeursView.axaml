<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Auth.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Auth.Models"
             xmlns:shared="using:GestionCommerciale.Shared.Views"
             xmlns:conv="using:GestionCommerciale.Shared.Converters"
             xmlns:personnel="using:GestionCommerciale.Modules.Personnel.Services"
             xmlns:fact="using:GestionCommerciale.Modules.Facturation.Models"
             x:Class="GestionCommerciale.Modules.Auth.Views.VendeursView"
             x:DataType="vm:VendeursViewModel">
  <Grid ColumnDefinitions="420,*">
    <Border Padding="12" CornerRadius="8" BorderBrush="#28000000" BorderThickness="1"
            Background="#06000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Button Content="{Binding BtnNew}" MinWidth="140" Padding="8,6" Margin="0,0,0,10"
                Command="{Binding NewVendeurCommand}" HorizontalAlignment="Left"/>
        <TextBlock Grid.Row="1" Text="{Binding HelpList}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="{Binding WmSearch}" Margin="0,0,0,8"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                  BorderBrush="#20000000" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,140,70">
              <TextBlock Text="{Binding ColNom}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding ColPhone}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="{Binding ColActif}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Vendeurs}" SelectedItem="{Binding Selected}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,8"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:User">
                <Grid ColumnDefinitions="*,140,70">
                  <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Phone}" VerticalAlignment="Center"
                             Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Actif, Converter={x:Static conv:BoolActifLabelConverter.Instance}}"
                             VerticalAlignment="Center" TextAlignment="Center" FontSize="11" Opacity="0.85"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" CornerRadius="8"
            BorderBrush="#28000000" BorderThickness="1" Background="#06000000"
            IsVisible="{Binding ShowFiche}">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding LblFiche}" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LblDraftHint}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       IsVisible="{Binding IsNewDraft}"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,12,*,12,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LblNom}" FontWeight="SemiBold" FontSize="12"/>
              <TextBox Text="{Binding FicheNom}" IsEnabled="{Binding FicheEditable}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="{Binding LblPhone}" FontWeight="SemiBold" FontSize="12"/>
              <TextBox Text="{Binding FichePhone}" IsEnabled="{Binding FicheEditable}"/>
            </StackPanel>
            <CheckBox Grid.Column="4" Content="{Binding LblActif}" IsChecked="{Binding FicheActif}"
                      IsEnabled="{Binding FicheEditable}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <Border Padding="12" CornerRadius="8"
                    BorderBrush="#28000000" BorderThickness="1" Background="#08000000"
                    IsVisible="{Binding ShowSolde}">
              <StackPanel Spacing="10">
                <Button Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding ToggleStockSectionCommand}">
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="{Binding IsStockExpanded, Converter={x:Static conv:BoolToExpandArrowConverter.Instance}}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource CourseraPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding LblSolde}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </Grid>
                </Button>

                <Grid ColumnDefinitions="*,*">
                  <Border Background="#E0F2FE" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding LblQtyTotal}" FontSize="11" Foreground="#0369A1"/>
                      <TextBlock Text="{Binding QtyTotalLabel}" FontSize="15" FontWeight="Bold" Foreground="#0C4A6E"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="8" Padding="10,8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding LblValVenteTtc}" FontSize="11" Foreground="#047857"/>
                      <TextBlock Text="{Binding ValVenteTtcLabel}" FontSize="15" FontWeight="Bold" Foreground="#065F46"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <StackPanel Spacing="4" IsVisible="{Binding IsStockExpanded}">
                  <TextBlock Text="{Binding EmptyStock}" FontSize="12" Opacity="0.7"
                             IsVisible="{Binding !HasStockLines}"/>

                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasStockLines}">
                    <Border Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                            BorderBrush="#20000000" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="110,*,80,140">
                        <TextBlock Text="{Binding ColRef}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding ColDesignation}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ColQty}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Foreground="#0369A1"/>
                        <TextBlock Grid.Column="3" Text="{Binding ColValVenteTtc}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="8,0,0,0" Foreground="#047857"/>
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding StockLines}" BorderThickness="0" Background="Transparent"
                             MaxHeight="280">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="10,6"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:VendeurStockLineRow">
                          <Grid ColumnDefinitions="110,*,80,140">
                            <TextBlock Text="{Binding Reference}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Designation}" FontSize="11" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding QuantiteLabel}" FontSize="11" TextAlignment="Right"
                                       FontWeight="SemiBold" Foreground="#0369A1"/>
                            <TextBlock Grid.Column="3" Text="{Binding ValeurVenteTtcLabel}" FontSize="11" TextAlignment="Right"
                                       Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#065F46"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    BorderBrush="#28000000" BorderThickness="1" Background="#08000000"
                    IsVisible="{Binding ShowCaisse}">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                  <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalContentAlignment="Left" Command="{Binding ToggleCaisseSectionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding IsCaisseExpanded, Converter={x:Static conv:BoolToExpandArrowConverter.Instance}}"
                                 FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource CourseraPrimaryBrush}"/>
                      <TextBlock Text="{Binding LblCaisse}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" IsVisible="{Binding ShowCaisseDateFilter}"
                          Content="{Binding BtnFilterCaisseDate}"
                          Command="{Binding FilterCaisseDateCommand}"
                          MinWidth="140" Padding="8,6" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  <Button Grid.Column="3" Content="{Binding BtnNewRemise}" Command="{Binding ToggleRemiseFormCommand}"
                          MinWidth="120" Margin="0,0,8,0"/>
                  <Button Grid.Column="4" Content="{Binding BtnDeleteRemise}" Command="{Binding DeleteRemiseCommand}"
                          IsEnabled="{Binding CanDeleteRemise}" Classes="pos-delete" MinWidth="100"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" IsVisible="{Binding IsCaisseExpanded}">
                  <Button Grid.Column="0" Command="{Binding SelectCaisseVentesCommand}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,6,0"
                          Cursor="Hand">
                    <Border Background="#FEF3C7" CornerRadius="8" Padding="10,8"
                            BorderBrush="#B45309"
                            BorderThickness="{Binding IsVentesBadgeSelected, Converter={x:Static conv:BoolToThicknessConverter.Instance}}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding LblVentes}" FontSize="11" Foreground="#B45309"/>
                        <TextBlock Text="{Binding VentesLabel}" FontSize="15" FontWeight="Bold" Foreground="#92400E"/>
                      </StackPanel>
                    </Border>
                  </Button>
                  <Button Grid.Column="1" Command="{Binding SelectCaisseEncaisseCommand}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,6,0"
                          Cursor="Hand">
                    <Border Background="#E0E7FF" CornerRadius="8" Padding="10,8"
                            BorderBrush="#4338CA"
                            BorderThickness="{Binding IsEncaisseBadgeSelected, Converter={x:Static conv:BoolToThicknessConverter.Instance}}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding LblEncaisse}" FontSize="11" Foreground="#4338CA"/>
                        <TextBlock Text="{Binding EncaisseLabel}" FontSize="15" FontWeight="Bold" Foreground="#3730A3"/>
                      </StackPanel>
                    </Border>
                  </Button>
                  <Button Grid.Column="2" Command="{Binding SelectCaisseRemisCommand}"
                          Background="Transparent" BorderThickness="0" Padding="0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,6,0"
                          Cursor="Hand">
                    <Border Background="#DCFCE7" CornerRadius="8" Padding="10,8"
                            BorderBrush="#15803D"
                            BorderThickness="{Binding IsRemisBadgeSelected, Converter={x:Static conv:BoolToThicknessConverter.Instance}}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding LblRemis}" FontSize="11" Foreground="#15803D"/>
                        <TextBlock Text="{Binding RemisLabel}" FontSize="15" FontWeight="Bold" Foreground="#166534"/>
                      </StackPanel>
                    </Border>
                  </Button>
                  <Border Grid.Column="3" Background="#FEE2E2" CornerRadius="8" Padding="10,8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding LblARemettre}" FontSize="11" Foreground="#B91C1C"/>
                      <TextBlock Text="{Binding ARemettreLabel}" FontSize="15" FontWeight="Bold" Foreground="#991B1B"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <StackPanel Spacing="12" IsVisible="{Binding IsCaisseExpanded}">
                <Border Padding="12" CornerRadius="8" BorderBrush="#30000000" BorderThickness="1"
                        Background="#10000000" IsVisible="{Binding ShowRemiseForm}">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding LblRemiseForm}" FontWeight="SemiBold" FontSize="13"
                                 VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="✕" ToolTip.Tip="{Binding BtnCancelRemise}"
                              Command="{Binding CloseRemiseFormCommand}"
                              Width="28" Height="28" Padding="0"
                              Background="Transparent" BorderThickness="0"
                              FontSize="14" Opacity="0.7"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*,12,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding LblRemiseDate}" FontWeight="SemiBold" FontSize="12"/>
                        <CalendarDatePicker SelectedDate="{Binding RemiseDate}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{Binding LblRemiseMode}" FontWeight="SemiBold" FontSize="12"/>
                        <ComboBox ItemsSource="{Binding RemiseModes}" SelectedItem="{Binding RemiseMode}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate DataType="fact:ModePaiement">
                              <TextBlock Text="{Binding ., Converter={x:Static conv:ModePaiementLabelConverter.Instance}}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="{Binding LblRemiseMontant}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox Text="{Binding RemiseMontant, Mode=TwoWay}"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding LblNote}" FontWeight="SemiBold" FontSize="12"/>
                      <TextBox Text="{Binding RemiseNote, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{Binding BtnSaveRemise}" Command="{Binding SaveRemiseCommand}"
                              MinWidth="120"/>
                      <Button Content="{Binding BtnCancelRemise}" Command="{Binding CloseRemiseFormCommand}"
                              MinWidth="120"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="4" IsVisible="{Binding ShowVentesDetail}">
                  <TextBlock Text="{Binding EmptyVentes}" FontSize="12" Opacity="0.7"
                             IsVisible="{Binding !HasVenteBlLines}"/>
                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasVenteBlLines}">
                    <Border Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                            BorderBrush="#20000000" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="110,90,*,120">
                        <TextBlock Text="{Binding ColBlNumero}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding ColDate}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ColClient}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ColMontant}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="8,0,0,0"/>
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding VenteBlLines}" BorderThickness="0"
                             Background="Transparent">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="10,6"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="personnel:VendeurVenteBlRow">
                          <Grid ColumnDefinitions="110,90,*,120">
                            <TextBlock Text="{Binding Numero}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding ClientNom}" FontSize="11" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding MontantLabel}" FontSize="11" TextAlignment="Right"
                                       Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#92400E"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowEncaisseDetail}">
                  <TextBlock Text="{Binding EmptyEncaisse}" FontSize="12" Opacity="0.7"
                             IsVisible="{Binding !HasEncaisseLines}"/>
                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasEncaisseLines}">
                    <Border Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                            BorderBrush="#20000000" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="110,90,*,120">
                        <TextBlock Text="{Binding ColBlNumero}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding ColDate}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ColRemiseMode}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ColMontant}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="8,0,0,0"/>
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding EncaisseLines}" BorderThickness="0"
                             Background="Transparent">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="10,6"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="personnel:VendeurEncaisseRow">
                          <Grid ColumnDefinitions="110,90,*,120">
                            <TextBlock Text="{Binding BlNumero}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding ModeLabel}" FontSize="11" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding MontantLabel}" FontSize="11" TextAlignment="Right"
                                       Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#3730A3"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding ShowRemisDetail}">
                  <TextBlock Text="{Binding EmptyRemises}" FontSize="12" Opacity="0.7"
                             IsVisible="{Binding !HasRemiseLines}"/>
                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasRemiseLines}">
                    <Border Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8"
                            BorderBrush="#20000000" BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="110,90,*,120">
                        <TextBlock Text="{Binding ColRemiseNumero}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding ColRemiseDate}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ColRemiseMode}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding ColRemiseMontant}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="8,0,0,0"/>
                      </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding RemiseLines}" SelectedItem="{Binding SelectedRemise}"
                             BorderThickness="0" Background="Transparent">
                      <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                          <Setter Property="Padding" Value="10,6"/>
                        </Style>
                      </ListBox.Styles>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="personnel:VendeurRemiseRow">
                          <Grid ColumnDefinitions="110,90,*,120">
                            <TextBlock Text="{Binding Numero}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding DateLabel}" FontSize="11" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding ModeLabel}" FontSize="11" Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding MontantLabel}" FontSize="11" TextAlignment="Right"
                                       Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#166534"/>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding ShowCaissePagination}">
                  <shared:ListPaginationBar DataContext="{Binding CaissePagination}"/>
                </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="{Binding BtnSave}" Command="{Binding SaveCommand}"
                  IsEnabled="{Binding FicheEditable}" MinWidth="120"/>
          <Button Content="{Binding BtnDelete}" Command="{Binding DeleteCommand}"
                  IsEnabled="{Binding CanDelete}" Classes="pos-delete" MinWidth="120"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
