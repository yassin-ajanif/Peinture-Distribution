<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GestionCommerciale.Modules.Stock.ViewModels"
             xmlns:m="using:GestionCommerciale.Modules.Stock.Models"
             xmlns:conv="using:GestionCommerciale.Shared.Converters"
             xmlns:shared="using:GestionCommerciale.Shared.Views"
             x:Class="GestionCommerciale.Modules.Stock.Views.StockMainView"
             x:DataType="vm:StockMainViewModel">
  <Grid ColumnDefinitions="2*,*">
    <Border Padding="12" Margin="0,0,12,0" CornerRadius="8" BorderBrush="#28000000" BorderThickness="1"
            Background="#06000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Text="{Binding LblCatalog}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{Binding HelpStock}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,8"/>
        <TextBox Grid.Row="2" Text="{Binding ProductSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Watermark="{Binding WmSearch}" Margin="0,0,0,8" MaxWidth="480" HorizontalAlignment="Left"/>
        <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8" BorderBrush="#20000000" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="140,*,100,88">
              <TextBlock Text="{Binding ColRef}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="{Binding ColDesignation}" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="{Binding ColStock}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="{Binding ColMinDot}" FontWeight="SemiBold" FontSize="12" TextAlignment="Right"/>
            </Grid>
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding Produits}" SelectedItem="{Binding SelectedProduit}"
                   BorderThickness="0" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,8"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="m:Produit">
                <Grid ColumnDefinitions="140,*,100,88">
                  <TextBlock Text="{Binding Reference}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Designation}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding StockActuel, StringFormat={}{0:N2}}"
                             TextAlignment="Right" VerticalAlignment="Center"
                             Foreground="{Binding ., Converter={x:Static conv:StockMinForegroundConverter.Instance}}"/>
                  <TextBlock Grid.Column="3" Text="{Binding StockMinimum, StringFormat={}{0:N2}}"
                             TextAlignment="Right" VerticalAlignment="Center" Opacity="0.85"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}"/>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Column="1" Padding="12" CornerRadius="8" BorderBrush="#28000000" BorderThickness="1"
            Background="#06000000">
      <StackPanel>
        <TextBlock Text="{Binding LblAdjustManual}" FontWeight="SemiBold" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding HelpStock}"
                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,12"/>

        <TextBlock Text="{Binding LblVariation}" FontSize="11" Opacity="0.65" Margin="0,0,0,4"/>
        <NumericUpDown Value="{Binding AjustementDelta}" FormatString="N2" Minimum="-999999" Maximum="999999"
                       Margin="0,0,0,12"/>

        <TextBlock Text="{Binding LblMotifTrace}" FontSize="11" Opacity="0.65" Margin="0,0,0,4"/>
        <TextBox Text="{Binding AjustementNote}" Watermark="{Binding WmAdjustNote}" Margin="0,0,0,12"/>

        <Button Content="{Binding BtnApply}" MinWidth="110" Padding="14,8"
                HorizontalAlignment="Stretch"
                Command="{Binding AjustementCommand}" Margin="0,0,0,12"/>

        <Button Content="{Binding BtnHistory}" MinWidth="110" Padding="14,8"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenHistoryCommand}"
                IsEnabled="{Binding CanOpenHistory}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
