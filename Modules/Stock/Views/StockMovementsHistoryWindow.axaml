<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GestionCommerciale.Modules.Stock.ViewModels"
        xmlns:m="using:GestionCommerciale.Modules.Stock.Models"
        xmlns:conv="using:GestionCommerciale.Shared.Converters"
        xmlns:shared="using:GestionCommerciale.Shared.Views"
        x:Class="GestionCommerciale.Modules.Stock.Views.StockMovementsHistoryWindow"
        x:DataType="vm:StockMovementsHistoryViewModel"
        Title="{Binding ProductTitle}"
        Width="1100"
        Height="640"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
    <TextBox Text="{Binding MovementClientSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Watermark="{Binding WmMovementClientSearch}"
             MaxWidth="420"
             HorizontalAlignment="Left"
             Margin="0,0,0,10"/>

    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="#12000000" CornerRadius="4,4,0,0" Padding="10,8" BorderBrush="#20000000" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="110,70,*,1.1*,1.1*,70,78">
          <TextBlock Text="{Binding ColDate}" FontWeight="SemiBold" FontSize="11"/>
          <TextBlock Grid.Column="1" Text="{Binding ColType}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
          <TextBlock Grid.Column="2" Text="{Binding ColDetail}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
          <TextBlock Grid.Column="3" Text="{Binding ColFrom}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
          <TextBlock Grid.Column="4" Text="{Binding ColTo}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
          <TextBlock Grid.Column="5" Text="{Binding ColQty}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right" Margin="0,0,4,0"/>
          <TextBlock Grid.Column="6" Text="{Binding ColStockCurrent}" FontWeight="SemiBold" FontSize="11" TextAlignment="Right"/>
        </Grid>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding Mouvements}" BorderThickness="0" Background="Transparent">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:MouvementStock">
            <Grid ColumnDefinitions="110,70,*,1.1*,1.1*,70,78">
              <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding TypeLabel}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.9"/>
              <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="2">
                <Button Classes="docLink"
                        Content="{Binding DocumentRef}"
                        FontSize="11"
                        Opacity="0.85"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding CanOpenOrigin}"
                        Command="{Binding $parent[Window].((vm:StockMovementsHistoryViewModel)DataContext).OpenOriginDocumentCommand}"
                        CommandParameter="{Binding}"/>
                <TextBlock Text="{Binding DocumentRef}" FontSize="11" Opacity="0.85"
                           IsVisible="{Binding !CanOpenOrigin}"/>
                <TextBlock Text="{Binding PartyName}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding PartyColorSignal, Converter={x:Static conv:PositiveNegativeForegroundConverter.Instance}}"
                           IsVisible="{Binding HasPartyName}"/>
                <TextBlock Text="{Binding UnitPriceDetail}" FontSize="10" Opacity="0.75"
                           IsVisible="{Binding HasUnitPriceDetail}"/>
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding FromLocationLabel}" FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="6,0,0,0" ToolTip.Tip="{Binding FromLocationLabel}"/>
              <TextBlock Grid.Column="4" Text="{Binding ToLocationLabel}" FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="6,0,0,0" ToolTip.Tip="{Binding ToLocationLabel}"/>
              <TextBlock Grid.Column="5" Text="{Binding QuantiteSignedLabel}" TextAlignment="Right" VerticalAlignment="Center"
                         TextWrapping="NoWrap" Margin="0,0,4,0" FontWeight="SemiBold" FontSize="11"
                         Foreground="{Binding SignedQuantite, Converter={x:Static conv:PositiveNegativeForegroundConverter.Instance}}"/>
              <TextBlock Grid.Column="6" Text="{Binding StockApres, StringFormat={}{0:N2}}"
                         TextAlignment="Right" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <shared:ListPaginationBar Grid.Row="2" DataContext="{Binding Pagination}" Margin="0,8,0,0"/>

    <Button Grid.Row="3"
            Content="{Binding BtnClose}"
            Command="{Binding CloseCommand}"
            HorizontalAlignment="Right"
            MinWidth="110"
            Padding="14,8"
            Margin="0,12,0,0"/>
  </Grid>
</Window>
